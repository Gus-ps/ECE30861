# Copy to .env (never commit it). All values below are placeholders.

# development allows http:// loopback targets; production requires HTTPS targets
APP_ENV=development
TESTER_DB_PATH=tester.db

# lowercase SHA256(operator token) -> operator subject; the raw operator token is never stored
TESTER_OPERATOR_TOKEN_HASHES_JSON={"<64-hex-sha256-of-operator-token>":"operator-1"}

# exact approved system base URLs (no /test suffix, query, fragment or credentials)
ALLOWED_TARGET_URLS=["http://127.0.0.1:8000"]

# exact base URL -> raw tokens for the four identities the target provisions
TARGET_AUTH_MAP_JSON={"http://127.0.0.1:8000":{"userA":"<token>","userB":"<token>","reviewer":"<token>","test-admin":"<token>"}}

# optional overrides; defaults are the files in tester/fixtures/
# MANIFEST_PATH=tester/fixtures/manifest.json
# POD_PROFILE_PATH=tester/fixtures/pod_profile.json

# optional fixture pack: expectations.json with its workbooks beside it; every SHA256 is
# verified at startup and at each setup (unset = no fixture pack)
# EXPECTATIONS_PATH=path/to/pack/expectations.json

# optional run-record evidence (never sent in the suite report)
# TESTER_REVISION=<tester commit>
# TARGET_REVISIONS_JSON={"http://127.0.0.1:8000":"<target revision>"}
