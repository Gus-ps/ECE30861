# Production settings for the Team 12 tester. Copy to deploy/tester.env (Compose) or
# /etc/team12-tester/tester.env (systemd), fill in real values, and keep it private (chmod 600).
# Never commit the filled-in file. JSON values are single-quoted so systemd, Docker Compose
# and the app's own .env loader all read them identically.

# production rejects any target that is not HTTPS
APP_ENV=production

# Persistent, private SQLite file; reports live here. The Docker image already sets /data/tester.db.
TESTER_DB_PATH=/var/lib/team12-tester/tester.db

# Prefix the reverse proxy strips before forwarding. Empty for a subdomain root, as Team 12
# deploys it (https://tester.13.184.14.226.sslip.io); /tester behind a stripped path prefix.
# Used by the Docker image; the systemd unit sets --root-path (or not) itself.
ROOT_PATH=

# lowercase SHA256(operator token) -> operator subject. Generate with:
#   uv run python scripts/make_operator_token.py --subject team12-operator
# Hand the raw token to graders/podmates privately; only its hash goes here.
TESTER_OPERATOR_TOKEN_HASHES_JSON='{"<64-hex-sha256-of-operator-token>":"team12-operator"}'

# Exact approved system base URLs: HTTPS, no /test suffix, query, fragment or credentials,
# and the same trailing-slash choice the operator will send.
ALLOWED_TARGET_URLS='["https://3.139.178.70.sslip.io/system","https://13.184.14.226.sslip.io"]'

# Exact base URL -> raw tokens for the four identities each target provisions (received privately).
# The tester also accepts two optional identities, "reviewer-ungranted" (a reviewer with no grant on
# userA's workbooks) and "test-admin-2" (a test-admin that did not create the session). Both are
# deferred to Phase 6 (Teams 9 and 12), so leave them out for Phase 5: the 5 access cases needing
# them skip and name the missing identity. Any other role name is refused at startup.
TARGET_AUTH_MAP_JSON='{"https://3.139.178.70.sslip.io/system":{"userA":"<token>","userB":"<token>","reviewer":"<token>","test-admin":"<token>"},"https://13.184.14.226.sslip.io":{"userA":"<token>","userB":"<token>","reviewer":"<token>","test-admin":"<token>"}}'

# Optional overrides; defaults are the manifest and pod profile shipped in tester/fixtures/.
# MANIFEST_PATH=/path/to/manifest.json
# POD_PROFILE_PATH=/path/to/pod_profile.json

# Adopted fixture pack: expectations.json with its workbooks beside it. Every SHA256 is checked
# at startup and at each setup; a changed file refuses setup before any session is created.
# EXPECTATIONS_PATH=/path/to/pack/expectations.json

# Phase 5 (MANIFEST_PATH=tester/fixtures/manifest_phase5.json, POD_PROFILE_PATH=tester/fixtures/pod_profile_phase5.json,
# EXPECTATIONS_PATH=tester/fixtures/expectations_phase5.json: the Phase 4 pack plus the 250,000-cell workbook):
# own-team runs report coverage.model, cross-team runs must omit it (spec 3.0.0 §14). The kind of run
# comes only from these settings: this tester's team, and the team of every approved base URL, as the
# exact strings in ALLOWED_TARGET_URLS (the tester refuses to start if one is missing). Registered
# system URLs, confirmed 2026-11-18, both without a trailing slash: Team 12 https://13.184.14.226.sslip.io ,
# Team 9 https://3.139.178.70.sslip.io/system . Testers: Team 12 https://tester.13.184.14.226.sslip.io ,
# Team 9 https://3.139.178.70.sslip.io/tester .
# TESTER_TEAM_ID=team12
# TARGET_TEAMS_JSON='{"https://3.139.178.70.sslip.io/system":"team9","https://13.184.14.226.sslip.io":"team12"}'
# Team 12's design map; an own-team setup without a valid one fails with 500/tester.
# DESIGN_MAP_PATH=tester/fixtures/design_map_team12.json

# Run-record evidence, kept in the database and never sent in the suite report.
# Read a record with: uv run python scripts/run_record.py --db <TESTER_DB_PATH> --session <id>
# TESTER_REVISION=<tester commit>
# TARGET_REVISIONS_JSON='{"https://<team9-host>/system":"<revision>","https://<team12-host>/system":"<revision>"}'
