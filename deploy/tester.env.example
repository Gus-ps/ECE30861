# Production settings for the Team 12 tester. Copy to deploy/tester.env (Compose) or
# /etc/team12-tester/tester.env (systemd), fill in real values, and keep it private (chmod 600).
# Never commit the filled-in file. JSON values are single-quoted so systemd, Docker Compose
# and the app's own .env loader all read them identically.

# production rejects any target that is not HTTPS
APP_ENV=production

# Persistent, private SQLite file; reports live here. The Docker image already sets /data/tester.db.
TESTER_DB_PATH=/var/lib/team12-tester/tester.db

# Prefix the reverse proxy strips before forwarding (empty if served at the host root).
# Used by the Docker image; the systemd unit passes --root-path itself.
ROOT_PATH=/tester

# lowercase SHA256(operator token) -> operator subject. Generate with:
#   uv run python scripts/make_operator_token.py --subject team12-operator
# Hand the raw token to graders/podmates privately; only its hash goes here.
TESTER_OPERATOR_TOKEN_HASHES_JSON='{"<64-hex-sha256-of-operator-token>":"team12-operator"}'

# Exact approved system base URLs: HTTPS, no /test suffix, query, fragment or credentials,
# and the same trailing-slash choice the operator will send.
ALLOWED_TARGET_URLS='["https://<team9-host>/system","https://<team12-host>/system"]'

# Exact base URL -> raw tokens for the four identities each target provisions (received privately).
TARGET_AUTH_MAP_JSON='{"https://<team9-host>/system":{"userA":"<token>","userB":"<token>","reviewer":"<token>","test-admin":"<token>"},"https://<team12-host>/system":{"userA":"<token>","userB":"<token>","reviewer":"<token>","test-admin":"<token>"}}'

# Optional overrides; defaults are the manifest and pod profile shipped in tester/fixtures/.
# MANIFEST_PATH=/path/to/manifest.json
# POD_PROFILE_PATH=/path/to/pod_profile.json

# Adopted fixture pack: expectations.json with its workbooks beside it. Every SHA256 is checked
# at startup and at each setup; a changed file refuses setup before any session is created.
# EXPECTATIONS_PATH=/path/to/pack/expectations.json

# Run-record evidence, kept in the database and never sent in the suite report.
# Read a record with: uv run python scripts/run_record.py --db <TESTER_DB_PATH> --session <id>
# TESTER_REVISION=<tester commit>
# TARGET_REVISIONS_JSON='{"https://<team9-host>/system":"<revision>","https://<team12-host>/system":"<revision>"}'
